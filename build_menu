name: Build Kernel with AnyKernel3

on:
  workflow_dispatch:

env:
  # 你的内核仓库（注意是 owner/repo 格式）
  KERNEL_REPO: 'fenghuang11451/xiaomi_xaga_kernel'
  # 分支名（默认是 mglru，根据你的实际情况）
  KERNEL_BRANCH: 'mglru'
  # 使用 xaga_defconfig（之前确认过的）
  DEVICE_DEFCONFIG: 'xaga_defconfig'
  # 伪装的内核版本号（uname -r 的后半段）
  LOCALVERSION: '-Android12-9-00020-gc9f59ef34367-ab9585114'

jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - name: 安装编译依赖
        run: |
          sudo apt update
          sudo apt install -y git zip make gcc-aarch64-linux-gnu lz4 \
            flex bison libssl-dev ccache bc

      - name: 下载 Clang 工具链
        run: |
          git clone --depth=1 \
            https://github.com/crdroidandroid/android_prebuilts_clang_host_linux-x86_clang-r416183b \
            clang
          echo "$PWD/clang/bin" >> $GITHUB_PATH

      - name: 检出内核源码
        uses: actions/checkout@v4
        with:
          repository: ${{ env.KERNEL_REPO }}
          ref: ${{ env.KERNEL_BRANCH }}
          path: kernel

      - name: 检出 AnyKernel3
        uses: actions/checkout@v4
        with:
          repository: osm0sis/AnyKernel3
          path: anykernel3

      - name: 编译内核
        working-directory: kernel
        run: |
          # 伪造构建时间（uname -v）
          export KBUILD_BUILD_TIMESTAMP="2023-02-08 23:50:57 +0000"

          # 1. 生成基础配置
          make ARCH=arm64 ${{ env.DEVICE_DEFCONFIG }}

          # 2. 修复 CPU 掩码（根据 mt6895.dtsi 确认的 1+3+4 架构）
          scripts/config --file .config --set-str LITTLE_CPU_MASK "0x0F"
          scripts/config --file .config --set-str BIG_CPU_MASK "0x70"
          scripts/config --file .config --set-str PRIME_CPU_MASK "0x80"

          # 3. 自动填充其他所有选项（避免交互菜单）
          yes "" | make ARCH=arm64 oldconfig

          # 4. 正式编译
          make -j$(nproc) \
            ARCH=arm64 \
            CROSS_COMPILE=aarch64-linux-gnu- \
            CC=clang \
            LOCALVERSION="${{ env.LOCALVERSION }}" \
            CONFIG_LTO_CLANG=y \
            CONFIG_LTO_NONE=n \
            CONFIG_LTO_CLANG_THIN=y \
            CONFIG_LTO_CLANG_FULL=n \
            CONFIG_LOCALVERSION_AUTO=n

      - name: 打包 AnyKernel3
        run: |
          # 复制内核镜像（优先 Image）
          if [ -f kernel/arch/arm64/boot/Image ]; then
            cp kernel/arch/arm64/boot/Image anykernel3/zImage
          elif [ -f kernel/arch/arm64/boot/Image.gz ]; then
            cp kernel/arch/arm64/boot/Image.gz anykernel3/zImage
          else
            echo "❌ 内核镜像未找到！"
            exit 1
          fi

          cd anykernel3
          # 清理多余文件
          rm -rf .git README.md *placeholder
          # 打包（文件名不包含动态日期，避免检测）
          zip -r9 ../Kernel.zip * -x .git README.md *placeholder
          cd ..

      - name: 上传编译结果
        uses: actions/upload-artifact@v4
        with:
          name: Kernel-Package
          path: Kernel.zip
